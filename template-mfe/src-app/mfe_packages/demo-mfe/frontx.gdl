# What this micro-frontend needs from a product's backend, for the tools that
# assemble one (Gearbox, Constructor Studio). Its screens and extensions stay
# in mfe.json. See "Package descriptions: frontx.gdl" in the repository README.
gdl_version = "1.6"

mfe(
    # The backend gears its screens call, by gear id. None: its accounts API
    # (`/api/accounts`) is mocked, not a gear's.
    requires = [],
)
